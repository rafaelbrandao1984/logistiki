---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Contabilidade para Terceiro Setor em Brasília | Logistiki" description="Gestão contábil especializada para ONG's, Associações e Fundações em Brasília. Transparência e conformidade com a ITG 2002." canonicalUrl="https://www.logistiki.com.br/terceiro-setor">
    <Navbar />
    <header class="hero-internal text-center px-6" style="--hero-photo: url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1920&q=80');">
        <div class="max-w-4xl mx-auto">
            <span class="text-gold uppercase tracking-[0.3em] text-sm font-bold mb-4 block animate-pulse">Entidades Sem Fins Lucrativos</span>
            <h1 class="text-4xl md:text-6xl text-white mb-6 leading-tight">Terceiro <span class="text-gold italic">Setor</span></h1>
            <p class="text-lg md:text-xl text-gray-200 mb-10 max-w-2xl mx-auto font-light leading-relaxed">
                Gestão contábil com foco em transparência e prestação de contas. Segurança jurídica para que sua causa mude o mundo.
            </p>
        </div>
    </header>

    <section class="py-24 bg-white">
        <div class="container mx-auto px-6 lg:px-20 max-w-6xl">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div class="space-y-6 text-slate-600 text-lg leading-relaxed text-justify">
                    <h2 class="text-4xl mb-8 leading-snug text-navy">Contabilidade ética para <br><span class="text-gold">instituições de impacto social.</span></h2>
                    <p>O Terceiro Setor possui particularidades contábeis e fiscais rigorosas. O descumprimento de normas como a ITG 2002 pode acarretar a perda de imunidades e isenções tributárias valiosas para a entidade.</p>
                    <p>Nossa assessoria garante que sua ONG, Associação ou Fundação em Brasília esteja sempre em dia com as obrigações acessórias, garantindo a credibilidade necessária perante doadores, parceiros e órgãos fiscalizadores.</p>
                </div>
                <div class="p-10 rounded-xl shadow-2xl text-white" style="background: var(--sky);">
                    <h3 class="text-white font-bold uppercase text-sm mb-6 tracking-widest">Expertise no Setor:</h3>
                    <ul class="space-y-4 text-sm text-white/85">
                        <li class="flex items-start"><span class="text-white/60 mr-3">▪</span><span>Escrituração Contábil conforme a ITG 2002.</span></li>
                        <li class="flex items-start"><span class="text-white/60 mr-3">▪</span><span>Manutenção de Imunidades e Isenções (Cebas, etc).</span></li>
                        <li class="flex items-start"><span class="text-white/60 mr-3">▪</span><span>Elaboração de demonstrações para editais e doadores.</span></li>
                        <li class="flex items-start"><span class="text-white/60 mr-3">▪</span><span>Auditoria e transparência na aplicação de recursos.</span></li>
                    </ul>
                    <a href="https://wa.me/5561981901379" target="_blank" rel="noopener" class="mt-10 block text-center btn-cta-on-sky py-4 rounded-full font-bold">Assessorar Minha Entidade</a>
                </div>
            </div>
        </div>
    </section>
    <Footer />
    <WhatsAppButton />
</Layout>
