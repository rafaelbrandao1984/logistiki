<div id="mobile-menu" class="fixed top-0 left-0 w-full h-screen bg-navy z-[90] flex flex-col justify-center items-center p-10 md:hidden overflow-y-auto">
    <div class="flex flex-col space-y-6 text-center text-white font-bold uppercase tracking-widest">
        <a href="/#sobre" class="mobile-link text-xl">Sobre</a>
        <a href="/#especialidades" class="mobile-link text-xl">Atuação</a>
        <a href="/#servicos" class="mobile-link text-xl text-gold">Serviços</a>
        <a href="/parceiros.html" class="mobile-link text-xl">Parceiros</a>
        <a href="/#faq" class="mobile-link text-xl">FAQ</a>
        <a href="https://wa.me/5561981901379" target="_blank" rel="noopener" class="text-gold border border-gold py-4 px-10 rounded">Contato</a>
    </div>
</div>

<script>
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');
    function toggleMenu() { 
        if (menu) menu.classList.toggle('active'); 
        document.body.classList.toggle('overflow-hidden'); 
    }
    if (btn) btn.addEventListener('click', toggleMenu);
    links.forEach(link => link.addEventListener('click', toggleMenu));
</script>
