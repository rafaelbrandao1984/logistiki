<div id="mobile-menu" class="fixed top-0 left-0 w-full h-screen z-[90] flex flex-col justify-center items-center p-10 md:hidden overflow-y-auto" style="background: var(--white);">
    <div class="flex flex-col space-y-6 text-center font-bold uppercase tracking-widest" style="color: var(--navy);">
        <a href="/#sobre" class="mobile-link text-xl" style="color: var(--navy);">Sobre</a>
        <a href="/#nichos" class="mobile-link text-xl" style="color: var(--navy);">Nichos</a>
        <a href="/#servicos" class="mobile-link text-xl" style="color: var(--sky);">Serviços</a>
        <a href="/parceiros.html" class="mobile-link text-xl" style="color: var(--navy);">Parceiros</a>
        <a href="/#faq" class="mobile-link text-xl" style="color: var(--navy);">FAQ</a>
        <a href="https://wa.me/5561981901379" target="_blank" rel="noopener" class="py-4 px-10 rounded text-white" style="border: 2px solid var(--sky); background: var(--sky);">Contato</a>
    </div>
</div>

<script>
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');
    function toggleMenu() { 
        if (menu) menu.classList.toggle('active'); 
        document.body.classList.toggle('overflow-hidden'); 
    }
    if (btn) btn.addEventListener('click', toggleMenu);
    links.forEach(link => link.addEventListener('click', toggleMenu));
</script>
